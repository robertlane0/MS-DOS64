# Bochs 3.0 x86-64 BIOS boot config template for MS-DOS64
# Rendered per image variant by `make` (see Makefile gen-bochsrc rule):
#   make build/bochsrc-dos64.txt      -> IMAGE=build/dos64.img (smoke)
#   make build/bochsrc-dos64-full.txt -> IMAGE=build/dos64-full.img (full)
#   make build/bochsrc-dos64-lean.txt -> IMAGE=build/dos64-lean.img (lean)
# Do not edit the ata0-master path here by hand; run targets substitute
# @IMAGE@ with the matching disk image so `run-bochs-full` cannot boot the
# smoke image. All other settings are authoritative in this file and are
# preserved verbatim into every rendered config.
# See docs/05-boot-and-testing-strategy.md — updated for Bochs 3.0 model presets
megs: 256
romimage: file=$BXSHARE/BIOS-bochs-latest
vgaromimage: file=$BXSHARE/VGABIOS-lgpl-latest.bin
# CHS 20/16/63 matches the MBR/stage2 CHS-fallback assumptions (SPT=63,
# HPC=16). The 10 MiB image is 20480 sectors; CHS covers 20160 of them
# ("extra data outside CHS" warning is harmless: the kernel uses LBA
# exclusively after boot, and all used LBAs — kernel 16+, scratch
# 200/500-511, FAT12 volume 512-3391 — are < 20160).
ata0-master: type=disk, path="@IMAGE@", mode=flat, cylinders=20, heads=16, spt=63
boot: disk
log: bochs.log
cpu: model=ryzen, count=1, ips=50000000, reset_on_triple_fault=1, ignore_bad_msrs=1
panic: action=report
magic_break: enabled=1
# Serial is write-only capture (guest -> serial.log). The COMMAND64 shell
# prints banner/prompt here; interactive input comes from PS/2 (GUI) —
# for pipe-driven automation use QEMU -serial stdio instead.
# NOTE: all serial TX is bounded best-effort diagnostic I/O
# (serial_try_putc in MBR/stage2, serial_try_putc64 in the kernel:
# SERIAL_TIMEOUT polls, drop on timeout, never hang). The timeout budget
# covers 16550 baud per-byte delay, so bursts (banner/prompt) are intact
# on Bochs while QEMU (instant THRE) never drops; a stuck/absent UART
# only drops diagnostics (VGA stays authoritative) instead of stalling
# boot or the shell.
com1: enabled=1, mode=file, dev=serial.log
display_library: nogui
